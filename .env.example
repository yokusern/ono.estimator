# ONO Estimator v4.0 Environment Variables

# --- AI & NOTIFICATION ---
GEMINI_API_KEY=your_gemini_key_here
DISCORD_WEBHOOK_AI=your_webhook_url
DISCORD_WEBHOOK_SVLW=your_webhook_url
DISCORD_WEBHOOK_TKS=your_webhook_url

# --- DATA SOURCES (Hybrid Strategy) ---
# Main: https://twelvedata.com/
TWELVE_DATA_API_KEY=your_twelve_data_key

# Backup: https://api.tiingo.com/
TIINGO_API_KEY=your_tiingo_key

# Fallback: yfinance (No key required)

# --- NEWS & MACD (Optional for deeper context) ---
NEWS_API_KEY=your_news_key
ALPHA_VANTAGE_API_KEY=your_alpha_key
FRED_API_KEY=your_fred_key

# --- CONNECTION ---
# Render: https://your-backend.onrender.com (No trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000
