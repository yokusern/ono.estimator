# ======================================================
# ONO Estimator v8.0 — 環境変数一覧
# Render (バックエンド) と Vercel (フロントエンド) に設定すること
# ======================================================

# ─── OANDA REST API v20 (FXリアルタイムデータ取得のみ使用) ────────
# ※ 本システムはOANDAを「データソース」として使用します。注文は行いません。
#
# 取得先: https://www.oanda.com/us-en/trading/accounts/open/
#   1. OANDA口座にログイン → 右上のアカウントアイコン → 「APIアクセス」
#   2. 「個人用アクセストークン」を発行 → OANDA_API_KEY に設定
#   3. 口座番号（例: 001-001-XXXXXXX-001）→ OANDA_ACCOUNT_ID に設定
#
# OANDA_PRACTICE について:
#   false = fxTrade本番口座のAPIを使用（本番口座を持っている場合）
#   true  = fxTrade Practice（練習口座）のAPIを使用
#   ※ データ取得のみ目的なら どちらでも動作します。持っている口座に合わせてください。
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_PRACTICE=false

# ─── Supabase ──────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# ─── Discord Webhook ───────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_AI=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_SV=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_LW=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_TKS=https://discord.com/api/webhooks/...

# ─── Gemini API (AI分析) ──────────────────────────────
# 取得先: https://aistudio.google.com/app/apikey
# 複数キーを設定するとレート制限時にローテーション
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here   # (オプション) ローテーション用2枚目
GEMINI_API_KEY_3=your_gemini_api_key_3_here   # (オプション) ローテーション用3枚目
GEMINI_MODEL=gemini-2.0-flash                  # モデル名（変更する場合のみ）

# ─── FRED (マクロ経済データ — オプション) ──────────────
# 取得先: https://fred.stlouisfed.org/docs/api/api_key.html
# 未設定でも yfinance フォールバックで動作する
FRED_API_KEY=your_fred_api_key

# ─── Twelve Data (データフォールバック — オプション) ──────
# 取得先: https://twelvedata.com/account/api-keys
# yfinance が取得できない銘柄のバックアップとして使用
TWELVE_DATA_API_KEY=your_twelve_data_api_key

# ─── Alpha Vantage (マクロ・経済指標 — オプション) ──────
# 取得先: https://www.alphavantage.co/support/#api-key
# FREDと組み合わせてDXY・VIX・金利データを補完
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# ─── Telegram 通知 (Discord代替 / 追加通知先 — オプション) ──
# 取得先: @BotFather で Bot 作成 → token 取得
# CHAT_ID: https://api.telegram.org/bot<TOKEN>/getUpdates で確認
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─── サーキットブレーカー設定 ──────────────────────────
# 1日に何連敗したら新規エントリーを停止するか（デフォルト: 3）
DAILY_LOSS_LIMIT=3

# ─── Gemini LLMコスト上限 (D-9) ───────────────────────
# 1日あたりの最大Gemini API呼び出し回数（デフォルト: 300）
# シンボル数 × スキャン回数が増えても青天井にならないよう制限する
# 10シンボル × 288回/日(5分周期) = 2880回 → 300で大幅削減
MAX_DAILY_LLM_CALLS=300

# ─── Render URL (スリープ対策 self-ping 用) ────────────
RENDER_EXTERNAL_URL=https://ono-estimator.onrender.com

# ─── フロントエンド (Vercel) ───────────────────────────
NEXT_PUBLIC_API_URL=https://ono-estimator.onrender.com
