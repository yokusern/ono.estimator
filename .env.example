# ======================================================
# ONO Estimator v6.3 — 環境変数一覧
# Render (バックエンド) と Vercel (フロントエンド) に設定すること
# ======================================================

# ─── Gemini AI (マルチキー対応) ────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_MODEL=gemini-2.0-flash

# ─── Supabase ──────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# ─── Discord Webhook ───────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_AI=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_SV=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_LW=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_TKS=https://discord.com/api/webhooks/...

# ─── LINE Messaging API（LINE Notify は2025年3月末廃止済み → 移行必須）──
# 取得先: https://developers.line.biz/ → チャンネル → Channel Access Token
LINE_CHANNEL_TOKEN=your_line_channel_access_token
LINE_USER_ID=your_line_user_id

# ─── FRED (マクロ経済データ) ───────────────────────────
FRED_API_KEY=your_fred_api_key

# ─── 日次目標管理 ──────────────────────────────────────
DAILY_PROFIT_TARGET_JPY=50000

# ─── Render URL (スリープ対策 self-ping 用) ────────────
RENDER_EXTERNAL_URL=https://ono-estimator.onrender.com

# ─── フロントエンド (Vercel) ───────────────────────────
NEXT_PUBLIC_API_URL=https://ono-estimator.onrender.com
